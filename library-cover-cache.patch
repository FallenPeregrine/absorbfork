+import 'package:cached_network_image/cached_network_image.dart';
+import 'package:flutter_cache_manager/flutter_cache_manager.dart';
+
+import 'stable_cached_network_image.dart';
+
+/// A shared disk cache for browsing artwork, separate from transient images.
+/// Retention is bounded by entry count and time since last use; the OS may
+/// still reclaim cache files. HTTP freshness is handled by the cache manager.
+class LibraryCoverCache {
+  static final instance = CacheManager(Config(
+    'absorbLibraryCoversV1',
+    stalePeriod: const Duration(days: 180),
+    maxNrOfCacheObjects: 2000,
+  ));
+}
+
+/// Keep the authenticated request URL intact, but reuse item covers after a
+/// token refresh. The key still includes server, size and artwork revision.
+/// Decode sizing stays with callers so a large library doesn't exhaust RAM.
+class LibraryCachedCover extends CachedNetworkImage {
+  LibraryCachedCover({
+    super.key,
+    required String imageUrl,
+    super.fit,
+    super.httpHeaders,
+    super.memCacheWidth,
+    super.placeholder,
+    super.errorWidget,
+  }) : super(
+          imageUrl: imageUrl,
+          cacheKey: stableCoverCacheKey(imageUrl),
+          cacheManager: LibraryCoverCache.instance,
+          fadeInDuration: Duration.zero,
+          fadeOutDuration: Duration.zero,
+          placeholderFadeInDuration: Duration.zero,
+        );
+}
